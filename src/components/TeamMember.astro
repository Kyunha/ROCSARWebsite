---
interface Props {
  name: string;
  role: string;
  bio: string;
  skills: string[];
}

const { name, role, bio, skills } = Astro.props;
---

<div class="card">
  <div class="header">
    <h3>{name}</h3>
    <span class="role">{role}</span>
  </div>
  <p class="bio">{bio}</p>
  <div class="skills">
    {skills.map((skill) => <span class="tag">{skill}</span>)}
  </div>
</div>

<style>
  .card {
    background: var(--card-bg);
    border: 1px solid var(--border-color);
    border-radius: 12px;
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }
  h3 {
    margin: 0;
    font-size: 1.25rem;
  }
  .role {
    color: var(--accent-color);
    font-size: 0.875rem;
    font-weight: 600;
    display: block;
    margin-top: 0.25rem;
  }
  .bio {
    color: var(--subtext-color);
    font-size: 0.9rem;
    line-height: 1.5;
    margin: 1rem 0;
  }
  .skills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .tag {
    background: var(--tag-bg);
    color: var(--tag-color);
    font-size: 0.75rem;
    font-family: monospace;
    padding: 0.25rem 0.5rem;
    border-radius: 6px;
  }
</style>
