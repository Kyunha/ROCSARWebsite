---
interface Props {
  title: string;
}

const { title } = Astro.props;

// Strip any trailing slash from base, then explicitly format routes
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
  </head>
  <body>
    <header class="navbar">
      <div class="nav-container">
        <span class="logo">⚡ Project Portal</span>
        <nav>
          <a href={`${base}/`}>The Project</a>
          <a href={`${base}/team/`}>The Team</a>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>
  </body>
</html>
