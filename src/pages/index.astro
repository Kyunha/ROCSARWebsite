---
import Layout from '../layouts/Layout.astro';
import { ROCSAR_INFO } from '../data';

// Required to map image paths correctly on GitHub Pages
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<Layout title={`${ROCSAR_INFO.name} | Overview`}>
  <section class="hero">
    <h1>{ROCSAR_INFO.name}</h1>
    <h2 class="tagline">{ROCSAR_INFO.tagline}</h2>
    <p class="description">{ROCSAR_INFO.description}</p>
  </section>

  <section class="section">
    <h2>Mission Objectives</h2>
    <div class="grid-3">
      {ROCSAR_INFO.objectives.map(obj => (
        <div class="card">
          <h3>{obj.title}</h3>
          <p>{obj.desc}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="section">
    <h2>Project Timeline</h2>
    <div class="timeline">
      {ROCSAR_INFO.timeline.map(item => (
        <div class="timeline-item">
          <div class="date">{item.date}</div>
          <div class="content">
            <h3>{item.title}</h3>
            <p>{item.desc}</p>
          </div>
        </div>
      ))}
    </div>
  </section>

  <section class="section">
    <h2>Hardware & Design</h2>
    <div class="grid-3">
      {ROCSAR_INFO.designPhotos.map(photo => (
        <div class="photo-card">
          <!-- The base URL is prepended so GitHub Pages finds the public folder -->
          <img src={`${base}/${photo.url}`} alt={photo.caption} onerror="this.src='data:image/svg+xml;utf8,<svg xmlns=\\'http://www.w3.org/2000/svg\\' width=\\'100%\\' height=\\'200\\' fill=\\'%23313244\\'><rect width=\\'100%\\' height=\\'100%\\'/><text x=\\'50%\\' y=\\'50%\\' dominant-baseline=\\'middle\\' text-anchor=\\'middle\\' fill=\\'%23a6adc8\\'>Image Placeholder</text></svg>'"/>
          <p class="caption">{photo.caption}</p>
        </div>
      ))}
    </div>
  </section>
</Layout>

<style>
  .hero { text-align: center; margin-bottom: 4rem; }
  h1 { font-size: 2.5rem; color: #f5e0dc; margin-bottom: 0.5rem; }
  .tagline { color: var(--accent-color); font-size: 1.25rem; margin-top: 0; }
  .description { color: var(--subtext-color); font-size: 1.1rem; line-height: 1.6; max-width: 700px; margin: 1rem auto; }
  
  h2 { border-bottom: 1px solid var(--border-color); padding-bottom: 0.5rem; color: #cba6f7; margin-bottom: 1.5rem; }
  
  .section { margin-bottom: 4rem; }
  .grid-3 { display: grid; gap: 1.5rem; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); }
  
  .card { background: var(--card-bg); padding: 1.5rem; border-radius: 8px; border: 1px solid var(--border-color); }
  .card h3 { margin-top: 0; color: #f5e0dc; }
  .card p { color: var(--subtext-color); font-size: 0.95rem; line-height: 1.5; margin-bottom: 0;}
  
  /* Timeline styling */
  .timeline { border-left: 2px solid var(--border-color); padding-left: 1.5rem; margin-left: 1rem; }
  .timeline-item { margin-bottom: 1.5rem; position: relative; }
  .timeline-item::before { content: ''; position: absolute; left: -1.85rem; top: 0.25rem; width: 12px; height: 12px; border-radius: 50%; background: var(--accent-color); }
  .date { font-size: 0.85rem; color: var(--accent-color); font-family: monospace; font-weight: bold; }
  .content h3 { margin: 0.25rem 0; color: #f5e0dc; }
  .content p { margin: 0; color: var(--subtext-color); font-size: 0.95rem; }
  
  /* Photo styling */
  .photo-card { background: var(--card-bg); border-radius: 8px; overflow: hidden; border: 1px solid var(--border-color); }
  .photo-card img { width: 100%; height: 200px; object-fit: cover; display: block; background: #313244; }
  .caption { padding: 1rem; margin: 0; text-align: center; color: var(--subtext-color); font-size: 0.9rem; font-weight: 500; }
</style>
