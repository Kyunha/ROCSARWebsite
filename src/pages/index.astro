---
import TeamMember from '../components/TeamMember.astro';

const teamMembers = [
  {
    name: "Alex Rivera",
    role: "Embedded Systems Lead",
    bio: "Focuses on low-level firmware development, real-time Operating Systems, and micro-controller communication protocols.",
    skills: ["C/C++", "RP2040", "FreeRTOS", "SPI/I2C"]
  },
  {
    name: "Sam Chen",
    role: "RF & Hardware Engineer",
    bio: "Designs PCB layouts, antenna front-ends, and handles high-frequency analog simulations.",
    skills: ["KiCad", "RF Design", "LTspice", "EM Simulation"]
  },
  {
    name: "Elena Rostova",
    role: "Software & Telemetry Lead",
    bio: "Develops cross-platform telemetry dashboards, WebSocket server backends, and deployment automation.",
    skills: ["Rust", "TypeScript", "Astro", "Linux"]
  }
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Engineering Team Presentation</title>
  </head>
  <body>
    <main>
      <header>
        <h1>Engineering Team</h1>
        <p>Building high-reliability systems across hardware, firmware, and telemetry infrastructure.</p>
      </header>

      <section class="grid">
        {teamMembers.map((member) => <TeamMember {...member} />)}
      </section>
    </main>
  </body>
</html>

<style>
  body {
    margin: 0;
    background-color: #11111b;
    color: #cdd6f4;
    font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    display: flex;
    justify-content: center;
    padding: 3rem 1.5rem;
  }
  main {
    max-width: 900px;
    width: 100%;
  }
  header {
    margin-bottom: 3rem;
  }
  h1 {
    font-size: 2.5rem;
    margin: 0 0 0.5rem 0;
    color: #f5e0dc;
  }
  header p {
    color: #a6adc8;
    font-size: 1.1rem;
    margin: 0;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1.5rem;
  }
</style>
