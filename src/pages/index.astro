---
import Layout from '../layouts/Layout.astro';

const subsystems = [
  {
    title: "Firmware & Processing",
    description: "Multicore real-time firmware execution, low-latency communication loops, and sensor telemetry capture.",
    tech: ["RP2040", "C++ / Rust", "FreeRTOS", "SPI / I2C"]
  },
  {
    title: "RF & Hardware Design",
    description: "Custom high-frequency front-end design, signal conditioning circuitry, and active filtering pipelines.",
    tech: ["KiCad", "LTspice", "RF Amplifiers", "PCB Substrates"]
  },
  {
    title: "Telemetry & Interface",
    description: "Real-time visual monitoring dashboards, WebSocket streaming protocols, and ground control utilities.",
    tech: ["TypeScript", "Astro", "WebSockets", "NixOS"]
  }
];
---

<Layout title="Project Overview | Engineering Team">
  <section class="hero">
    <span class="badge">Active Research & Development</span>
    <h1>Embedded & Systems Engineering Platform</h1>
    <p class="subtitle">
      A high-reliability system designed for real-time sensor processing, custom microwave front-ends, and low-latency control loops.
    </p>
  </section>

  <section class="section">
    <h2>Mission Objectives</h2>
    <div class="objectives-grid">
      <div class="obj-card">
        <h3>01. Ultra-Low Latency</h3>
        <p>Maintain precise hardware timer synchronization and deterministic command execution across subsystem buses.</p>
      </div>
      <div class="obj-card">
        <h3>02. Signal Integrity</h3>
        <p>Optimize analog active filtering and high-frequency RF amplification loops for low noise operation.</p>
      </div>
      <div class="obj-card">
        <h3>03. Modular Architecture</h3>
        <p>Ensure modular bus protocols (UART, SPI, I2C) allow rapid integration of custom microcontrollers and sensors.</p>
      </div>
    </div>
  </section>

  <section class="section">
    <h2>Subsystem Breakdown</h2>
    <div class="subsystem-list">
      {subsystems.map((sub) => (
        <div class="sub-card">
          <div class="sub-header">
            <h3>{sub.title}</h3>
            <div class="tags">
              {sub.tech.map((t) => <span class="tag">{t}</span>)}
            </div>
          </div>
          <p>{sub.description}</p>
        </div>
      ))}
    </div>
  </section>
</Layout>

<style>
  .hero {
    margin-bottom: 4rem;
  }
  .badge {
    background: #313244;
    color: #f5e0dc;
    font-size: 0.8rem;
    padding: 0.3rem 0.75rem;
    border-radius: 20px;
    font-family: monospace;
  }
  h1 {
    font-size: 2.5rem;
    margin: 1rem 0 0.5rem 0;
    color: #f5e0dc;
  }
  .subtitle {
    font-size: 1.2rem;
    color: var(--subtext-color);
    line-height: 1.6;
    margin: 0;
  }
  .section {
    margin-bottom: 3.5rem;
  }
  h2 {
    font-size: 1.5rem;
    border-bottom: 1px solid var(--border-color);
    padding-bottom: 0.5rem;
    margin-bottom: 1.5rem;
    color: var(--accent-color);
  }
  .objectives-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1.5rem;
  }
  .obj-card {
    background: var(--card-bg);
    border: 1px solid var(--border-color);
    border-radius: 10px;
    padding: 1.25rem;
  }
  .obj-card h3 {
    margin: 0 0 0.5rem 0;
    font-size: 1.05rem;
    color: #cba6f7;
  }
  .obj-card p {
    margin: 0;
    color: var(--subtext-color);
    font-size: 0.9rem;
    line-height: 1.5;
  }
  .subsystem-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .sub-card {
    background: var(--card-bg);
    border: 1px solid var(--border-color);
    border-radius: 10px;
    padding: 1.5rem;
  }
  .sub-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 0.75rem;
  }
  .sub-header h3 {
    margin: 0;
    font-size: 1.15rem;
  }
  .sub-card p {
    margin: 0;
    color: var(--subtext-color);
    font-size: 0.95rem;
  }
  .tags {
    display: flex;
    gap: 0.4rem;
    flex-wrap: wrap;
  }
  .tag {
    background: var(--tag-bg);
    color: var(--tag-color);
    font-size: 0.75rem;
    font-family: monospace;
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
  }
</style>
