---
import Layout from '../layouts/Layout.astro';
import { TEAM_MEMBERS } from '../data';

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<Layout title="The Team | ROCSAR Payload Experiment">
  <header class="header">
    <h1 class="title">Flight & Engineering Team</h1>
    <p>The core team, advisors, and flight operations personnel behind ROCSAR.</p>
  </header>

  <div class="team-grid">
    {TEAM_MEMBERS.map(member => (
      <div class="team-card">
        <div class="photo-container">
          <img 
            src={`${base}/${member.photoUrl}`} 
            alt={member.name || 'Team Member'} 
            onerror="this.src='data:image/svg+xml;utf8,<svg xmlns=\\'http://www.w3.org/2000/svg\\' width=\\'120\\' height=\\'120\\' fill=\\'%2312151d\\'><rect width=\\'100%\\' height=\\'100%\\'/><text x=\\'50%\\' y=\\'50%\\' dominant-baseline=\\'middle\\' text-anchor=\\'middle\\' fill=\\'%23475569\\' font-family=\\'sans-serif\\' font-size=\\'12\\'>Member Photo</text></svg>'"
          />
        </div>
        <div class="info">
          <h3>{member.name || "[ Team Member Name ]"}</h3>
          <span class="role">{member.role || "[ Engineering Role ]"}</span>
          <p class="bio">{member.bio || "[ Short bio detailing responsibilities and engineering contributions. ]"}</p>
          <div class="tags">
            {member.skills.map(skill => skill ? <span class="tag">{skill}</span> : null)}
          </div>
        </div>
      </div>
    ))}
  </div>
</Layout>

<style>
  .header { 
    text-align: center; 
    margin-bottom: 4rem; 
  }
  .title { 
    font-size: 2.5rem; 
    font-weight: 700;
    margin: 0 0 0.5rem 0; 
    color: var(--text-primary);
    letter-spacing: -0.02em;
  }
  .header p { 
    color: var(--text-secondary); 
    font-size: 1rem; 
    margin-top: 0; 
    font-weight: 300;
  }
  
  .team-grid { 
    display: grid; 
    gap: 1.5rem; 
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); 
  }
  .team-card { 
    background: var(--card-bg); 
    border-radius: 8px; 
    border: 1px solid var(--card-border); 
    padding: 2rem 1.5rem; 
    display: flex; 
    flex-direction: column; 
    align-items: center; 
    text-align: center; 
    transition: border-color 0.2s ease, transform 0.2s ease;
  }
  .team-card:hover {
    border-color: var(--card-border-hover);
    transform: translateY(-2px);
  }
  
  .photo-container { 
    width: 100px; 
    height: 100px; 
    border-radius: 50%; 
    overflow: hidden; 
    margin-bottom: 1.25rem; 
    border: 1px solid var(--card-border); 
    background: #12151d; 
  }
  .photo-container img { 
    width: 100%; 
    height: 100%; 
    object-fit: cover; 
    filter: grayscale(15%);
  }
  
  .info h3 { 
    margin: 0 0 0.25rem 0; 
    color: var(--text-primary); 
    font-size: 1.1rem; 
    font-weight: 600;
  }
  .role { 
    color: var(--accent-slate); 
    font-weight: 500; 
    font-size: 0.85rem; 
    margin-bottom: 1rem; 
    display: block; 
    letter-spacing: 0.01em;
  }
  .bio { 
    color: var(--text-secondary); 
    font-size: 0.88rem; 
    line-height: 1.6; 
    margin-bottom: 1.5rem; 
    font-weight: 300;
  }
  
  .tags { 
    display: flex; 
    flex-wrap: wrap; 
    gap: 0.35rem; 
    justify-content: center; 
    margin-top: auto; 
  }
  .tag { 
    background: var(--tag-bg); 
    border: 1px solid var(--card-border);
    color: var(--text-secondary); 
    padding: 0.2rem 0.5rem; 
    font-size: 0.72rem; 
    border-radius: 4px; 
    font-family: 'JetBrains Mono', monospace; 
  }
</style>
