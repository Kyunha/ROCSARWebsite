---
import Layout from '../layouts/Layout.astro';
import { TEAM_MEMBERS } from '../data';

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<Layout title="Meet the Team">
  <header class="header">
    <h1>The Team</h1>
    <p>The engineering and flight operations team behind ROCSAR.</p>
  </header>

  <div class="team-grid">
    {TEAM_MEMBERS.map(member => (
      <div class="team-card">
        <div class="photo-container">
          <img src={`${base}/${member.photoUrl}`} alt={member.name || 'Team Member'} onerror="this.src='data:image/svg+xml;utf8,<svg xmlns=\\'http://www.w3.org/2000/svg\\' width=\\'120\\' height=\\'120\\' fill=\\'%23313244\\'><rect width=\\'100%\\' height=\\'100%\\'/><text x=\\'50%\\' y=\\'50%\\' dominant-baseline=\\'middle\\' text-anchor=\\'middle\\' fill=\\'%23a6adc8\\'>Photo</text></svg>'"/>
        </div>
        <div class="info">
          <h3>{member.name || "[ Name ]"}</h3>
          <span class="role">{member.role || "[ Role ]"}</span>
          <p class="bio">{member.bio || "[ Insert bio description here. ]"}</p>
          <div class="tags">
            {member.skills.map(skill => skill ? <span class="tag">{skill}</span> : null)}
          </div>
        </div>
      </div>
    ))}
  </div>
</Layout>

<style>
  .header { text-align: center; margin-bottom: 3rem; }
  h1 { font-size: 2.5rem; color: #f5e0dc; margin-bottom: 0.5rem; }
  .header p { color: var(--subtext-color); font-size: 1.1rem; margin-top: 0; }
  
  .team-grid { display: grid; gap: 2rem; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); }
  .team-card { background: var(--card-bg); border-radius: 12px; border: 1px solid var(--border-color); overflow: hidden; display: flex; flex-direction: column; align-items: center; text-align: center; padding: 2rem 1.5rem; }
  
  .photo-container { width: 120px; height: 120px; border-radius: 50%; overflow: hidden; margin-bottom: 1.5rem; border: 3px solid var(--border-color); background: #313244; }
  .photo-container img { width: 100%; height: 100%; object-fit: cover; }
  
  .info h3 { margin: 0 0 0.25rem 0; color: #f5e0dc; font-size: 1.4rem; }
  .role { color: var(--accent-color); font-weight: 600; font-size: 0.95rem; margin-bottom: 1rem; display: block; }
  .bio { color: var(--subtext-color); font-size: 0.95rem; line-height: 1.6; margin-bottom: 1.5rem; }
  
  .tags { display: flex; flex-wrap: wrap; gap: 0.5rem; justify-content: center; margin-top: auto; }
  .tag { background: #313244; color: #cba6f7; padding: 0.25rem 0.6rem; font-size: 0.8rem; border-radius: 6px; font-family: monospace; }
</style>
