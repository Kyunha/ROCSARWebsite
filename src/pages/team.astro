---
import Layout from '../layouts/Layout.astro';
import { TEAM_MEMBERS } from '../data';
---

<Layout title="Meet the Team">
  <header style="margin-bottom: 3rem;">
    <h1 style="color: #f5e0dc; font-size: 2.5rem; margin-bottom: 0.5rem;">Meet the Team</h1>
    <p style="color: var(--subtext-color); font-size: 1.1rem; margin-top: 0;">The engineers and advisors behind the project.</p>
  </header>

  <div class="team-grid">
    {TEAM_MEMBERS.map(member => (
      <div class="team-card">
        <h3>{member.name}</h3>
        <span class="role">{member.role}</span>
        <p class="bio">{member.bio}</p>
        <div class="tags">
          {member.skills.map(skill => <span class="tag">{skill}</span>)}
        </div>
      </div>
    ))}
  </div>
</Layout>

<style>
  .team-grid { display: grid; gap: 1.5rem; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); }
  .team-card { background: var(--card-bg); padding: 1.5rem; border-radius: 8px; border: 1px solid var(--border-color); display: flex; flex-direction: column;}
  .team-card h3 { margin: 0 0 0.25rem 0; color: #f5e0dc; }
  .role { color: var(--accent-color); font-weight: 600; font-size: 0.9rem; margin-bottom: 1rem; display: block; }
  .bio { color: var(--subtext-color); font-size: 0.95rem; line-height: 1.5; flex-grow: 1; }
  .tags { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 1.5rem; }
  .tag { background: #313244; color: #cba6f7; padding: 0.25rem 0.5rem; font-size: 0.8rem; border-radius: 4px; font-family: monospace; }
</style>
